{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://soummam.com/schemas/demande_conge.json",
  "title": "Demande de Congé",
  "description": "Formulaire complet pour tester la validation et la visibilité dynamique",
  "documentType": "DEMANDE_CONGE",
  "type": "object",
  "properties": {
    "idEmploye": {
      "type": "integer",
      "title": "Identifiant Employé",
      "description": "Saisissez votre identifiant pour charger automatiquement vos informations."
    },
    "nomEmploye": {
      "type": "string",
      "title": "Nom de l'employé",
      "minLength": 2,
      "maxLength": 100,
      "readOnly": false
    },
    "prenomEmploye": {
      "type": "string",
      "title": "Prénom de l'employé",
      "minLength": 2,
      "maxLength": 100,
      "readOnly": false
    },
    "emailEmploye": {
      "type": "string",
      "format": "email",
      "title": "Email de l'employé",
      "readOnly": false
    },
    "typeConge": {
      "type": "string",
      "title": "Type de congé",
      "oneOf": [
        {
          "const": "ANNUEL",
          "title": "Congé Annuel"
        },
        {
          "const": "MALADIE",
          "title": "Congé Maladie"
        },
        {
          "const": "SANS_SOLDE",
          "title": "Congé Sans Solde"
        }
      ]
    },
    "periode": {
      "type": "object",
      "title": "Période du congé (Test des groupes)",
      "properties": {
        "dateDebut": {
          "type": "string",
          "format": "date",
          "title": "Date de début"
        },
        "dateFin": {
          "type": "string",
          "format": "date",
          "title": "Date de fin"
        }
      },
      "required": [
        "dateDebut",
        "dateFin"
      ]
    },
    "motif": {
      "type": "string",
      "title": "Motif / Description",
      "minLength": 10,
      "maxLength": 500
    },
    "referenceMedicale": {
      "type": "string",
      "title": "Numéro de certificat médical (MED-XXXXX)",
      "pattern": "^MED-[0-9]{5}$",
      "hidden": true
    },
    "commentaireRh": {
      "type": "string",
      "title": "Commentaire RH",
      "readOnly": true,
      "description": "Ce champ est grisé car réservé à l'administration."
    }
  },
  "required": [
    "idEmploye",
    "typeConge"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "typeConge": {
            "const": "MALADIE"
          }
        }
      },
      "then": {
        "required": [
          "referenceMedicale"
        ],
        "properties": {
          "referenceMedicale": {
            "hidden": false
          }
        }
      }
    }
  ]
}