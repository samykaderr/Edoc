{
    "$schema": "https://json-schema.org/draft-2020-12/schema",
    "$id": "https://votreentreprise.com/schemas/demande_conge.json",
    "title": "Demande de Congé",
    "description": "Formulaire de validation strict pour les demandes de congé",
    "type": "object",
    "documentType": "CONGE",
    "properties": {
        "idEmploye": {
            "type": "integer",
            "title": "Identifiant Employé",
            "description": "Saisissez votre identifiant pour charger automatiquement vos informations."
        },
        "nomEmploye": {
            "type": "string",
            "title": "Nom de l'employé",
            "minLength": 2,
            "maxLength": 100,
            "readOnly": true
        },
        "prenomEmploye": {
            "type": "string",
            "title": "Prénom de l'employé",
            "minLength": 2,
            "maxLength": 100,
            "readOnly": true
        },
        "emailEmploye": {
            "type": "string",
            "format": "email",
            "title": "Email de l'employé",
            "readOnly": true
        },
        "dateDebut": {
            "type": "string",
            "format": "date",
            "title": "Date de début"
        },
        "dateFin": {
            "type": "string",
            "format": "date",
            "title": "Date de fin"
        },
        "typeConge": {
            "type": "string",
            "title": "Type de congé",
            "oneOf": [
                {
                    "const": "ANNUEL",
                    "title": "Congé Annuel"
                },
                {
                    "const": "MALADIE",
                    "title": "Congé Maladie"
                },
                {
                    "const": "SANS_SOLDE",
                    "title": "Congé Sans Solde"
                }
            ]
        },
        "motif": {
            "type": "string",
            "title": "Motif / Description",
            "minLength": 10,
            "maxLength": 500
        },
        "referenceMedicale": {
            "type": "string",
            "title": "Numéro de certificat médical",
            "pattern": "^MED-[0-9]{5}$"
        }
    },
    "required": [
        "idEmploye",
        "dateDebut",
        "dateFin",
        "typeConge"
    ],
    "if": {
        "properties": {
            "typeConge": {
                "const": "MALADIE"
            }
        }
    },
    "then": {
        "required": [
            "referenceMedicale"
        ]
    }
}